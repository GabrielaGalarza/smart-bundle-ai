{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist/web",
  "rewrites": [
    { "source": "/widget", "destination": "/widget/index.html" },
    { "source": "/widget/", "destination": "/widget/index.html" },
    { "source": "/productos", "destination": "/index.html" },
    { "source": "/producto/:id", "destination": "/index.html" },
    { "source": "/marca/:brand", "destination": "/index.html" }
  ]
}
